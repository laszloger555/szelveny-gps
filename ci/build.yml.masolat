name: APK fordítás

on:
  push:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Csomagok telepítése
        run: npm install

      - name: Térképkönyvtár (Leaflet) bemásolása – offline működéshez
        run: |
          mkdir -p www/lib
          cp node_modules/leaflet/dist/leaflet.js node_modules/leaflet/dist/leaflet.css www/lib/
          cp -r node_modules/leaflet/dist/images www/lib/

      - name: Android projekt létrehozása
        run: |
          npx cap add android
          node ci/patch-android.js

      - name: Ikon generálása
        continue-on-error: true
        run: npx capacitor-assets generate --android --iconBackgroundColor '#ff6a13' --splashBackgroundColor '#14171a'

      - name: Szinkronizálás
        run: npx cap sync android

      - name: Állandó aláíró kulcs (így a frissítés felülírja a régit, nem kell törölni)
        run: |
          mkdir -p ~/.android
          cp ci/debug.keystore ~/.android/debug.keystore

      - name: APK fordítása
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: APK átnevezése
        run: cp android/app/build/outputs/apk/debug/app-debug.apk szelveny-gps.apk

      - uses: actions/upload-artifact@v4
        with:
          name: szelveny-gps-apk
          path: szelveny-gps.apk

      - name: Közzététel "latest" kiadásként (telefonról letölthető)
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release delete latest -y --cleanup-tag || true
          gh release create latest szelveny-gps.apk --title "Szelvény GPS – legfrissebb (1.0.${{ github.run_number }})" --notes "Automatikus build #${{ github.run_number }}, commit ${{ github.sha }}"
